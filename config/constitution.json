      "forest_navy": "#0a1f2e",
      "forest_navy_2": "#06202b"
    },
    "rules": [
      "no_pastel",
      "no_color_without_reference",
      "no_ai_language",
      "skip_empty_panels",
      "render_all_extracted_rows"
    ],
    "drop_empty_dates": true
  },
  "linting": {
    "blocking": [
      "panel_misclassification",
      "renal_membership_violation",
      "nfs_suborder_violation",
      "date_ambiguity",
      "pii_leak",
      "missing_required_fields",
      "duplicate_rows",

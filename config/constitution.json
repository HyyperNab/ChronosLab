  "reference_policy": {
    "extract_reference_words": true,
    "languages": [
      "en",
      "fr",
      "de",
      "nl",
      "es"
    ],
    "never_infer_reference": true,
    "display_once_per_variable": true,
    "missing_reference_display": "—",
    "reference_triggers": {
      "fr": [
        "Réf",
        "Référence",
        "Normes",
        "Valeurs usuelles",
        "Valeur de référence"

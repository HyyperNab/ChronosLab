  "scope": {
    "in_scope": [
      "multi_pdf_lab_ingestion",
      "ocr_with_bbox_trace",
      "identity_integrity_gate",
      "multilingual_lab_extraction",
      "explicit_unit_normalization",
      "chronological_timeline",
      "non_diagnostic_trends",
      "clinician_cockpit_html",
      "excel_pdf_exports",
      "descriptive_cohort_analysis"
    ],
    "out_of_scope": [
      "diagnosis",
      "therapy_recommendation",
      "risk_prediction",
      "clinical_decision_automation"
    ]
  },
  "privacy": {
    "grade": "GERMAN_STRICT",
    "pii_in_exports": false,
    "metadata_scrub": [
      "pdf",
      "excel",
      "html"
    ],
    "export_block_on_pii": true,
    "pii_patterns": [
      "\\b[A-Z][a-z]{2,}\\s+[A-Z][a-z]{2,}\\s+[A-Z][a-z]{2,}\\b",
      "\\b\\d{2}[/\\.]\\d{2}[/\\.]\\d{4}\\b",
      "\\b\\d{10,}\\b"
    ]
  },
  "identity_policy": {
    "one_patient_per_case": true,
    "conflict_behavior": "HARD_FAIL",
    "insufficient_identity": "HARD_FAIL",
    "minimum_identity_confidence": 0.85
  },
  "panel_labels": {
    "NFS": "Hémogramme (NFS)",
    "VS_H1": "Vitesse de Sédimentation H1",
    "VS_H2": "Vitesse de Sédimentation H2",
